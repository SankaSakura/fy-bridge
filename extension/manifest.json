{
  "manifest_version": 3,
  "name": "FY 本地反代",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "description": "将客户端的文本请求转发到已登录的 FY 专用卡，并通过本地 API 返回回复。",
  "permissions": ["scripting", "storage", "nativeMessaging", "alarms"],
  "host_permissions": ["https://aifun.wiki/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 FY 本地反代" }
}
